# Copy to .env and edit. All optional — the app runs without any of these.
ADMIN_KEY=change-this-secret
SECRET_KEY=change-this-too
TARGET=500
# Live seats shown to students (typical webinar cap). Above this, sign-ups join a waitlist.
SEAT_CAP=1000
WORKSHOP_DATE=Sunday, 11 Oct 2026 · 11:00 AM IST
# Used for the Add to Google Calendar button
WORKSHOP_START=2026-10-11T11:00:00+05:30
# Public URL once deployed, so share links point to it (no trailing slash)
BASE_URL=
# Optional: Claude writes personalised / regional-language share messages
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: n8n webhook that receives every new registration
N8N_WEBHOOK_URL=
